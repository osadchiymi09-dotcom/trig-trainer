    },
    {
      "id": "pow-ctg",
      "family": "Понижение степени",
      "title": "ctg² α",
      "formula": "$\\operatorname{ctg}^2\\alpha=\\dfrac{1+\\cos 2\\alpha}{1-\\cos 2\\alpha}$",
      "steps": [
        "Это $1/\\operatorname{tg}^2\\alpha$, или $\\cos^2/\\sin^2$ через понижение."
      ],
      "mother": false,
      "fromIds": [
        "pow-tg"
      ],
      "tip": ""
    },
    {
      "id": "tri-sin",
      "family": "Тройной угол",
      "title": "sin 3α",
      "formula": "$\\sin 3\\alpha=3\\sin\\alpha-4\\sin^3\\alpha$",
      "steps": [
