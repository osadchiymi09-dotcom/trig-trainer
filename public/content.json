    {
      "id": "sum-sin",
      "family": "Сумма → произведение",
      "title": "sin α ± sin β",
      "formula": "$\\sin\\alpha\\pm\\sin\\beta=2\\sin\\dfrac{\\alpha\\pm\\beta}{2}\\cos\\dfrac{\\alpha\\mp\\beta}{2}$",
      "steps": [
        "Положим $s=(\\alpha+\\beta)/2$, $d=(\\alpha-\\beta)/2$ → $\\alpha=s+d$, $\\beta=s-d$.",
        "Тогда $\\sin(s+d)+\\sin(s-d)$ — два раза мать sin(±).",
        "Сложи: $2\\sin s\\cos d$. Верни s и d."
      ],
      "mother": false,
      "fromIds": [
        "add-sin"
      ],
      "tip": ""
    },
    {
      "id": "sum-cos-p",
      "family": "Сумма → произведение",
      "title": "cos α + cos β",
      "formula": "$\\cos\\alpha+\\cos\\beta=2\\cos\\dfrac{\\alpha+\\beta}{2}\\cos\\dfrac{\\alpha-\\beta}{2}$",
      "steps": [
        "Та же замена s, d.",
        "$\\cos(s+d)+\\cos(s-d)=2\\cos s\\cos d$ из матери cos."
      ],
      "mother": false,
      "fromIds": [
        "add-cos"
      ],
      "tip": ""
    },
    {
      "id": "sum-cos-m",
      "family": "Сумма → произведение",
      "title": "cos α − cos β",
      "formula": "$\\cos\\alpha-\\cos\\beta=-2\\sin\\dfrac{\\alpha+\\beta}{2}\\sin\\dfrac{\\alpha-\\beta}{2}$",
      "steps": [
        "$\\cos(s+d)-\\cos(s-d)=-2\\sin s\\sin d$.",
        "Минус впереди — не потеряй."
      ],
      "mother": false,
      "fromIds": [
        "add-cos"
      ],
      "tip": ""
    },
    {
      "id": "sum-tg",
      "family": "Сумма → произведение",
      "title": "tg α ± tg β",
      "formula": "$\\operatorname{tg}\\alpha\\pm\\operatorname{tg}\\beta=\\dfrac{\\sin(\\alpha\\pm\\beta)}{\\cos\\alpha\\cos\\beta}$",
      "steps": [
        "$\\operatorname{tg}\\alpha\\pm\\operatorname{tg}\\beta=\\sin\\alpha/\\cos\\alpha\\pm\\sin\\beta/\\cos\\beta$.",
